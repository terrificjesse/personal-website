# Personal site: Next.js, `next start` against a production build of frontend/.
# Install to /etc/systemd/system/personal-website-frontend.service. The internships site has its
# own unit, personal-website-hunt.service, since 2026-11-11.
#
# It listens on loopback only. Nothing but the reverse proxy should be able to reach it, and
# binding it publicly would put a second origin on the host — the thing § One origin exists
# to avoid.
#
# **Through the --hostname flag, and only that.** `next start` reads PORT from the environment
# but not HOSTNAME, so the `Environment=HOSTNAME=127.0.0.1` this file used to carry did nothing,
# and it listened on every interface while this comment said otherwise.

[Unit]
Description=Hunt frontend (Next.js)
Documentation=file:///opt/personal-website/docs/DEPLOY.md
After=network-online.target personal-website-backend.service
Wants=network-online.target

[Service]
Type=simple
User=personal-website
Group=personal-website
WorkingDirectory=/opt/personal-website/frontend

Environment=NODE_ENV=production
Environment=PORT=3000
# NEXT_PUBLIC_* is baked in at BUILD time, not read here — see docs/DEPLOY.md § Redeploy.
# frontend.env is read at runtime, and must set HUNT_SITE_URL to the internships site: proxy.ts
# redirects /internships there, and answers 503 rather than guessing when it is unset.
EnvironmentFile=-/etc/personal-website/frontend.env

ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1

Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=personal-website-frontend

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# `next start` writes runtime caches (fetch cache, optimized images) into .next/cache, and
# ProtectSystem=strict makes the whole filesystem read-only otherwise. Without this the server
# starts and then fails at runtime in ways that look like application bugs.
ReadWritePaths=/opt/personal-website/frontend/.next

[Install]
WantedBy=multi-user.target
