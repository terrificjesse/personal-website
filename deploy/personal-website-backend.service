# Backend: Rust/axum, serving the fridge app, the blog, the internship tab and the hunt
# alert channel. Install to /etc/systemd/system/personal-website-backend.service.
#
# The path below is deliberately NOT a dated release directory. `CompanyTiers::load()`
# resolves its data file against `env!("CARGO_MANIFEST_DIR")` — the path the binary was BUILT
# in — so a layout that builds in `releases/<date>/` and then prunes old releases leaves the
# compiled-in path dangling. The tier file then fails to load, prestige silently becomes
# derived-only, and the tier-1/2 alert predicate stops firing. The symptom is no
# notifications, which is indistinguishable from a quiet job market.
# See docs/DEPLOY.md § The build path is load-bearing.

[Unit]
Description=Hunt backend (axum)
Documentation=file:///opt/personal-website/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=personal-website
Group=personal-website
WorkingDirectory=/opt/personal-website/apps/fridge-app/backend

# Secrets live outside every checkout, mode 600, owned by the service user.
EnvironmentFile=/etc/personal-website/backend.env

# Refuse to start on a misconfiguration rather than booting into one. A non-zero exit here
# fails the unit with the reason in the journal.
ExecStartPre=/opt/personal-website/deploy/preflight.sh /etc/personal-website/backend.env

ExecStart=/opt/personal-website/apps/fridge-app/backend/target/release/fridge_backend

Restart=on-failure
RestartSec=5s
# Five failures inside a minute stops the retry loop rather than hammering a broken config.
StartLimitBurst=5
StartLimitIntervalSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=personal-website-backend

# The database is the record of a hunt in progress. It lives here, not in the checkout, and
# this is the only path the service may write.
StateDirectory=personal-website
ReadWritePaths=/var/lib/personal-website

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
