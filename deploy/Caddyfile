# Two sites, one backend. Install to /etc/caddy/Caddyfile.
#
# `example.com` is the personal site and `hunt.example.com` the internships site, split apart on
# 2026-11-11 (docs/HUNT.md § "The internships site, split out"). Each is a single origin: its own
# Next app at `/`, and the one backend at `/api/*`. docs/DEPLOY.md § One origin per site says why.
#
# Caddy over nginx+certbot for one reason: automatic HTTPS with no renewal cron to forget.
# If the host already runs nginx, reproduce the routes below, the path stripping and the two
# header lines included, in both sites.
#
# THE ORDER OF THESE ROUTES MATTERS. `/api/*` is matched first; everything else falls through
# to Next. Reversing them serves the app for API calls, which arrives at the browser as JSON
# parse errors rather than as a 404.

# The backend, path-stripped: /api/health -> /health upstream. One snippet, so the two sites
# cannot drift apart on the two load-bearing header lines.
(backend_api) {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080 {
			# These two lines are load-bearing, not boilerplate. The backend's rate limiter
			# trusts X-Forwarded-For only when the TCP peer is loopback — which behind this
			# proxy it always is — and takes the LAST hop. Without them every caller on the
			# internet would share one login bucket, and an attacker could lock the real user
			# out by exhausting it.
			#
			# `header_up` SETS rather than appends, so a header forged by a remote client does
			# not survive the hop. Swapping this proxy for one that appends keeps the last-hop
			# rule working, but check that assumption rather than inheriting it.
			#
			# (Until 2026-09-02 the limiter ignored the header entirely and this comment said
			# so. See docs/DEPLOY.md § The rate limiter behind a proxy.)
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}

example.com {
	encode zstd gzip
	import backend_api

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	# The backend logs to the journal; these are the access logs.
	log {
		output file /var/log/caddy/site.log
		format json
	}
}

hunt.example.com {
	encode zstd gzip
	import backend_api

	handle {
		reverse_proxy 127.0.0.1:3001
	}

	log {
		output file /var/log/caddy/hunt.log
		format json
	}
}
