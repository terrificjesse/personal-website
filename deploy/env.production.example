# ------------------------------------------------------------------------------------------
# Production environment for the backend. Phase 10h.
#
# Copy to /etc/personal-website/backend.env on the host, fill it in, `chmod 600`, own it by the service
# user. **It never lives in the repo** — deploy/ holds this example and nothing else, and
# preflight.sh fails if DATABASE_URL points inside a checkout.
#
# Every line below says what happens when it is wrong, because every one of these has a
# failure mode that looks like something else.
# ------------------------------------------------------------------------------------------

# --- the single origin -------------------------------------------------------------------
# One host, one origin, both processes behind it. This is not a preference: a split origin
# means the session cookie has to become `SameSite=None; Secure` to survive a cross-site
# request, and `SameSite=Lax` on one origin is strictly safer. See docs/DEPLOY.md § One origin.

# Where Google sends the browser after consent. Must be the public origin, not localhost, or
# the OAuth round trip lands somewhere the user cannot reach.
FRONTEND_ORIGIN=https://hunt.example.com

# Credentialed CORS. CANNOT be `*` — browsers reject a wildcard on a cookie-carrying request,
# and the failure is silent: every call simply looks signed-out.
# With a single origin the site itself does not need CORS at all; this list exists for the
# Firefox extension. See docs/DEPLOY.md § The moz-extension wildcard before changing it.
ALLOWED_ORIGINS=https://hunt.example.com

# --- cookies -----------------------------------------------------------------------------
# MUST be true behind HTTPS. Left false, session cookies travel in the clear.
# preflight.sh refuses to start without it.
COOKIE_SECURE=true

# --- database ----------------------------------------------------------------------------
# Absolute path, outside every checkout, on a filesystem the backups (10i) also see.
# A relative path resolves against the service's WorkingDirectory and will silently create a
# second, empty database on the next deploy that changes it.
DATABASE_URL=sqlite:///var/lib/personal-website/fridge.db?mode=rwc

PORT=8080

# --- Google OAuth (sign-in) --------------------------------------------------------------
# All three or none. Half-configured reports "Google OAuth not configured" at boot and then
# 404-looking failures at the callback, which reads as a missing route.
# The redirect points at the BACKEND path behind the proxy — the callback needs the client
# secret, which must never reach the browser. It must match Google Cloud Console EXACTLY,
# including scheme, host and path; a mismatch is an opaque `redirect_uri_mismatch`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hunt.example.com/api/auth/google/callback

# --- Gmail (the inbox agent) --------------------------------------------------------------
# Same client id and secret as above; only the redirect differs.
GMAIL_REDIRECT_URI=https://hunt.example.com/api/auth/gmail/callback

# How often the unattended sync runs. **UNSET IS NOT OFF** — it defaults to 900s
# (`DEFAULT_SYNC_INTERVAL_SECS`). `0` disables it deliberately; a non-number disables it and
# logs, which looks identical to a Gmail outage from the outside.
INBOX_SYNC_INTERVAL_SECS=900

# Whether the agent writes labels into the real mailbox. **UNSET MEANS ON.**
# preflight.sh requires this to be set explicitly either way — that is task 10k, and a host
# that runs unattended against someone's mail should not inherit this by default.
INBOX_APPLY_LABELS=true

# Confidence at or above which an email-driven status change applies itself instead of
# queueing for review. Leave UNSET until Phase 13 measures a real number (task 13e); unset
# means nothing auto-applies, which is the safe direction and the current intent.
# INBOX_AUTO_APPLY_CONFIDENCE=

# --- follow-up nudges (Phase 11e) ---------------------------------------------------------
# How often the sweep looks for applications nobody has answered. UNSET IS NOT OFF — it
# defaults to 6 hours. `0` disables it deliberately.
# HUNT_NUDGE_INTERVAL_SECS=21600
# Days of silence worth chasing, comma-separated. Default "14,30". Each threshold notifies at
# most once per application: the alert is keyed "{application_id}:{threshold_days}".
# HUNT_NUDGE_DAYS=14,30

# --- deadline warnings (Phase 11f) ---------------------------------------------------------
# How often to check for approaching due dates. UNSET IS NOT OFF — it defaults to hourly, which
# is far more often than the nudge sweep because deadlines move in hours. `0` disables.
# HUNT_DEADLINE_INTERVAL_SECS=3600
# Hours before a due date to warn, comma-separated. Default "72,24" — one alert per deadline
# per lead time, keyed "{deadline_id}:{lead_hours}". A deadline already past raises nothing.
# HUNT_DEADLINE_LEAD_HOURS=72,24

# --- other tabs ---------------------------------------------------------------------------
# Blog markdown sync, and the internship collector's caps. See docs/INTERNSHIPS.md.
# BLOG_CONTENT_DIR=/opt/personal-website/content/blog
# BLOG_SYNC_INTERVAL_SECS=300
# Only needed if the tier file does not sit beside the executable or in the checkout. Losing
# it is silent — prestige degrades to derived-only and tier-1/2 alerts stop firing — so check
# the "company tiers loaded from" line at boot rather than assuming.
# INTERNSHIP_COMPANY_TIERS=/opt/personal-website/apps/fridge-app/backend/data/internships/company-tiers.json
# INTERNSHIP_MAX_BOARDS_PER_RUN=
# INTERNSHIP_MISS_THRESHOLD=
# INTERNSHIP_DISABLED_SOURCES=
