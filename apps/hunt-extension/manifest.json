{
  "manifest_version": 3,
  "name": "Internship Hunt",
  "version": "0.1.0",
  "description": "Desktop alerts when a tier-1 or tier-2 company posts a new internship.",

  "browser_specific_settings": {
    "gecko": {
      "id": "hunt@personal-website",
      "strict_min_version": "115.0"
    }
  },

  "permissions": ["alarms", "notifications", "storage"],

  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Internship Hunt",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
