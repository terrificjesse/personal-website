{
  "manifest_version": 3,
  "name": "Internship Hunt",
  "version": "0.1.0",
  "description": "Desktop alerts when a tier-1 or tier-2 company posts a new internship.",

  "browser_specific_settings": {
    "gecko": {
      "id": "hunt@personal-website",
      "strict_min_version": "115.0"
    }
  },

  "permissions": ["alarms", "notifications", "storage", "activeTab", "scripting"],

  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],

  "optional_host_permissions": ["https://*/*"],

  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": ["content/fields.js", "content/fill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Internship Hunt",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
