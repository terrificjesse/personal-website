# Installed as /etc/personal-website/backup.env with mode 600.
# These paths are the deployment layout consumed by fridge-db-backup.service.
FRIDGE_DB_PATH=/var/lib/personal-website/fridge.db
FRIDGE_BACKUP_DIR=/var/backups/personal-website
# Daily backups older than this are removed after a new verified snapshot is published.
# Use 0 to disable automatic retention.
FRIDGE_BACKUP_RETENTION_DAYS=30
