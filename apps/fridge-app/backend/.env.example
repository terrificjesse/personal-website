# Copy to `.env` (gitignored) and fill in. Every value here has a working local-dev default,
# so the app runs with no `.env` at all — Google sign-in is simply unavailable.

# ---------------------------------------------------------------------------------------
# Origins allowed to send credentialed (cookie-carrying) requests. Comma-separated.
# ---------------------------------------------------------------------------------------
# This CANNOT be `*`. Browsers reject a wildcard `Access-Control-Allow-Origin` on any request
# that carries credentials, and the failure is silent: the cookie is never sent and every
# call just looks signed-out. Add the LAN origin here when using the app from another device
# (`ipconfig getifaddr en0` for the current DHCP address).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.42:3000

# Where the Google OAuth callback sends the browser when it's done. The frontend's origin.
# FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------------------
# Set to `true` anywhere reachable over the internet. Left off by default because this app
# currently serves plain HTTP on a LAN, where a Secure cookie would never be sent at all and
# login would fail with no visible error.
# COOKIE_SECURE=false

# ---------------------------------------------------------------------------------------
# Google OAuth — you create these yourself in Google Cloud Console. Claude cannot.
# ---------------------------------------------------------------------------------------
# APIs & Services -> Credentials -> Create OAuth client ID -> Web application. The redirect
# URI must match GOOGLE_REDIRECT_URI below *exactly*, including scheme, host, port and path;
# a mismatch shows up as an opaque `redirect_uri_mismatch` error from Google.
#
# Note the redirect points at the BACKEND (:8080), not the frontend — the callback needs the
# client secret, which must never reach the browser.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback

# ---------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------
# DATABASE_URL=sqlite://fridge.db?mode=rwc

# ---------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------
# The port the backend binds. Defaults to 8080, which is what `apiBase()` in the frontend
# assumes, so leave it alone for normal use. It exists so a second instance can run beside
# the usual one — pointing at a throwaway database copy for verification, say — without
# having to stop the one that's already serving.
# PORT=8080

# ---------------------------------------------------------------------------------------
# Blog
# ---------------------------------------------------------------------------------------
# Where the blog looks for markdown posts. Defaults to `content/blog` at the repo root,
# resolved relative to this crate's source directory rather than the working directory —
# the backend runs three levels below the root, so a plain relative path would depend on
# where you launched it from. Set this only for a deployment where the source tree isn't
# next to the binary.
#
# A missing directory is logged and skipped, not an error: the blog falls back to posts
# written in the browser. See `content/blog/README.md` for the frontmatter schema.
# BLOG_CONTENT_DIR=/absolute/path/to/content/blog

# How often the backend re-checks that directory, in seconds. Defaults to 5.
#
# The check itself is one read_dir plus a stat per file — no file reads and no database
# round-trip — and it only does real work when the resulting (name, mtime, size) summary
# differs from the previous tick. So a quiet blog costs essentially nothing and logs nothing.
#
# Set to 0 to turn the background watcher off, leaving startup and POST /blog/sync as the
# only triggers. An unparseable value also disables it, and says so — a typo'd interval that
# silently behaved like the default would be a setting that looks applied and isn't.
# BLOG_SYNC_INTERVAL_SECS=5

# ---------------------------------------------------------------------------------------
# Internship collection (Phase 7) — none of these are required; the defaults are sane.
# ---------------------------------------------------------------------------------------
# How often a collection runs. Default 21600 (6h). 0 disables scheduled collection; the
# manual POST /internships/collect still works.
# INTERNSHIP_COLLECT_INTERVAL_SECS=21600
#
# How often the expiry sweep runs. Default 3600. 0 disables it.
# INTERNSHIP_EXPIRY_INTERVAL_SECS=3600
#
# Consecutive expiry-eligible runs a sighting must be absent for before it counts as gone.
# Default 3.
# INTERNSHIP_MISS_THRESHOLD=3
#
# Cap on boards polled per source per run. Unset means every board — ~2,084 slugs, on the
# order of half an hour of requests. BUT a capped run has not enumerated the source, so it
# reports Partial, and a Partial run can never expire anything. Convenient for development,
# wrong for steady state.
# INTERNSHIP_MAX_BOARDS_PER_RUN=6
#
# Comma-separated sources to skip. A disabled source still writes a Skipped run record.
# INTERNSHIP_DISABLED_SOURCES=linkedin,indeed
#
# Retention for posting_rejects payloads. `kind='rejected'` rows are NEVER pruned — they are
# the defects. Only `filtered` payloads age out: kept for the most recent N collection runs,
# and capped at M specimens per (source run, reason) inside that window. The COUNTS on
# source_runs are never touched, so the accounting outlives the evidence.
# Both accept 0 to disable that half of the pruning.
# On 2026-08-30 these took the database from 801 MB to 4.5 MB.
# INTERNSHIP_REJECT_RETENTION_RUNS=3
# INTERNSHIP_REJECT_SAMPLES_PER_REASON=20
